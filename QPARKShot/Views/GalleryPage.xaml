<Page x:Class="QPARKShot.Views.GalleryPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:QPARKShot.Localization" xmlns:local="clr-namespace:QPARKShot.Views" Background="Transparent">
 <Page.Resources><local:ThumbnailConverter x:Key="Thumbnail"/></Page.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="InspectorColumn" Width="252"/></Grid.ColumnDefinitions>
  <Grid Margin="16">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,12">
    <Button DockPanel.Dock="Right" Content="{l:Tr windows.refresh}" Click="OnRefresh"/>
    <TextBlock x:Name="Heading" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
   </DockPanel>
   <TextBlock x:Name="EmptyState" Grid.Row="1" Text="{l:Tr workspace.no_shots}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380"/>
   <ListBox x:Name="GalleryItems" Grid.Row="1" SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnOpen" KeyDown="OnListKey" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="workspace.items">
    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="6"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="AutomationProperties.Name" Value="{Binding FileName}"/></Style></ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate><DataTemplate>
     <StackPanel Width="210">
      <Border Height="134" Background="{DynamicResource CardFill}" CornerRadius="10" ClipToBounds="True">
       <Image Source="{Binding Path, Converter={StaticResource Thumbnail}}" Stretch="Uniform" FlowDirection="LeftToRight"/>
      </Border>
      <TextBlock Text="{Binding FileName}" Margin="0,9,0,3" TextTrimming="CharacterEllipsis"/>
      <StackPanel Orientation="Horizontal">
       <TextBlock Text="★ " Foreground="{DynamicResource QPARKAccent}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Favorite}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:g}}" Foreground="{DynamicResource SecondaryText}" FontSize="11"/>
      </StackPanel>
     </StackPanel>
    </DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </Grid>
  <Border Grid.Column="1" BorderBrush="{DynamicResource DividerStroke}" BorderThickness="1,0,0,0" Padding="16">
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Inspector"/></ScrollViewer>
  </Border>
 </Grid>
</Page>
